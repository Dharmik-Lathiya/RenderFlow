{
  "name": "@renderflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith (all HTTP)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch src/main.ts",
    "clean": "rm -rf dist .turbo coverage tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5",
    "@renderflow/common": "workspace:*",
    "@renderflow/observability": "workspace:*",
    "@nestjs/jwt": "^11.0.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "@renderflow/credits": "workspace:*",
    "@renderflow/db": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "@testcontainers/postgresql": "^11.10.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
