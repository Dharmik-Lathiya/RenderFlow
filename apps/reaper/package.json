{
  "name": "@renderflow/reaper",
  "version": "0.1.0",
  "private": true,
  "description": "Reaps stuck jobs and runs hourly ledger reconciliation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --no-experimental-strip-types --watch -r ts-node/register/transpile-only src/main.ts",
    "clean": "rm -rf dist .turbo coverage tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@renderflow/common": "workspace:*",
    "@renderflow/db": "workspace:*",
    "@renderflow/jobs": "workspace:*",
    "@renderflow/observability": "workspace:*",
    "@renderflow/queue": "workspace:*",
    "@renderflow/social": "workspace:*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.18.0"
  }
}
