{
  "name": "renderflow",
  "version": "0.1.0",
  "private": true,
  "description": "RenderFlow - AI marketing studio and social scheduler",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "test:chaos": "tests/chaos/run.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @renderflow/db generate",
    "db:migrate": "pnpm --filter @renderflow/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @renderflow/db migrate:deploy",
    "db:reset": "pnpm --filter @renderflow/db migrate:reset",
    "db:studio": "pnpm --filter @renderflow/db studio",
    "gen:api-client": "turbo run gen:api-client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.tsx": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.js": [
      "prettier --write"
    ],
    "*.mjs": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.yml": [
      "prettier --write"
    ],
    "*.yaml": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
