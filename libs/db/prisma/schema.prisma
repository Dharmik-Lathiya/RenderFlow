// RenderFlow database schema.
//
// PHASE 1 SCOPE: users, wallets, credit_ledger, pricing_rules (PROJECT.md section 6).
// Remaining tables arrive with the phase that builds against them:
//   Phase 3  workspaces, brands, campaigns, posts, assets
//   Phase 4  generation_jobs, job_checkpoints, outbox_events
//   Phase 7  social_accounts, publish_jobs, post_metrics
//
// PHASE 0 SCOPE: this file intentionally declared no domain models.
// AGENTS.md forbids editing a migration that has already been merged, so the data
// model is added incrementally, each phase adding its own migration alongside the
// logic that needs it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// users
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Lowercased and unique; the login key. See AuthService.normalizeEmail.
  email           String    @unique @db.VarChar(320)
  /// argon2id hash. Never selected into a response object.
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(120)
  /// Global role driving the /admin/* surface; workspace roles live on the
  /// workspace_members row (Phase 3).
  role            UserRole  @default(MEMBER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet          Wallet?
  refreshSessions RefreshSession[]
  creditLedgers   CreditLedger[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------------------
// wallets  (PROJECT.md section 5.2)
//
// `available` and `reserved` are CACHES of the ledger sums. The CHECK constraints
// below are the last line of defence: no code path may make a balance negative,
// and if one ever tries, the database refuses rather than silently trusting the
// application. Credit writes live only in libs/credits.
// ---------------------------------------------------------------------------

model Wallet {
  userId String @id @map("user_id") @db.Uuid

  /// Credits the user may spend right now.
  available Int @default(0)
  /// Credits held against in-flight jobs; spent on capture, returned on refund.
  reserved  Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// ---------------------------------------------------------------------------
// credit_ledger  (append-only)
//
// PROJECT.md section 5.9-5.10: every balance movement is a row. The unique
// constraint on (reference_type, reference_id, entry_type) is what makes
// reserve/capture/refund idempotent under retries and reaper/worker races.
// Rows are never updated or deleted outside test teardown.
// ---------------------------------------------------------------------------

model CreditLedger {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  entryType CreditEntryType @map("entry_type")
  /// Signed: credits granted are positive, credits spent (reserve/capture) are
  /// negative. Integers only - credits are never fractional.
  amount    Int

  /// Idempotency scope. SYSTEM entries have no reference (they are inherently
  /// unique per user via the signup-bonus constraint below).
  referenceType String? @map("reference_type") @db.VarChar(40)
  referenceId   String? @map("reference_id") @db.VarChar(64)

  /// Free-form operator/admin note. Never contains secrets.
  note String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_ledger")
}

enum CreditEntryType {
  SIGNUP_BONUS
  PURCHASE
  RESERVE
  CAPTURE
  REFUND
  ADJUSTMENT
  EXPIRY
}

// ---------------------------------------------------------------------------
// refresh_sessions
//
// Refresh tokens are stored hashed so a database leak does not hand an attacker
// usable sessions. Each row is one device; logout revokes it, and rotation
// replaces it, so a stolen refresh token has a bounded window.
// ---------------------------------------------------------------------------

model RefreshSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the refresh token, hex encoded. The plaintext only ever exists
  /// in the httpOnly cookie.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  userAgent String? @map("user_agent") @db.VarChar(255)
  ipAddress String? @map("ip_address") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
