# ---------------------------------------------------------------------------
# RenderFlow - local development environment
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# General
NODE_ENV=development
LOG_LEVEL=debug

# Database / Redis
DATABASE_URL=postgresql://renderflow:renderflow@postgres:5432/renderflow
# Host-local override for tools run outside compose (psql, Drizzle Studio).
DATABASE_URL_LOCAL=postgresql://renderflow:renderflow@localhost:5432/renderflow
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:6379

# Auth
# Generate strong values (the API refuses secrets shorter than 32 chars):
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# base64-encoded 32 bytes for AES-256-GCM on social tokens (Phase 7).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=base64-32-bytes

# Cheaper argon2 parameters. Test/CI only - production must keep the OWASP
# minimums (m=19456 KiB, t=2). Uncomment to speed up an integration run.
# ARGON2_MEMORY_COST=19456
# ARGON2_TIME_COST=2

# Credits
# The signup bonus. Granted once per user, in the same transaction as the user
# (PROJECT.md section 5.1). Never hardcoded in logic (AGENTS.md rule 6).
SIGNUP_BONUS_CREDITS=50

# Rate limiting (PROJECT.md section 14.10, section 15)
#
# Format is "<count>/<window>", e.g. "10/15m". A bare "0" disables one rule,
# which is the supported way to lift a limit during an incident without a
# redeploy. An unparseable value fails at boot rather than silently leaving an
# endpoint unlimited.
#
# LOGIN_IP is the primary control: argon2 costs roughly 50ms of CPU per request,
# so login is the endpoint worth bounding. LOGIN_ACCOUNT catches a distributed
# credential-stuffing run that per-IP limiting cannot see; it is deliberately
# generous, because a tight per-account limit is a lockout tool against any
# address an attacker knows.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP=10/15m
RATE_LIMIT_LOGIN_ACCOUNT=30/1h
RATE_LIMIT_REGISTER_IP=5/1h
RATE_LIMIT_REFRESH_IP=60/15m

# Jobs / reliability
#
# The lease trio is a safety property, not three independent knobs: a worker must
# be able to miss TWO heartbeats and still hold a valid lease, or the reaper will
# hand a live job to a second worker while the first is still rendering. The
# workers and the reaper validate this at boot and refuse to start otherwise.
MAX_JOB_ATTEMPTS=3          # attempts on the durable job row, not BullMQ's
JOB_LEASE_SECONDS=120       # how long a lease survives without a heartbeat
HEARTBEAT_SECONDS=30        # must be <= half of JOB_LEASE_SECONDS
REAPER_INTERVAL_SECONDS=60
# How long a job may sit PENDING and unclaimed before it is re-queued. Covers an
# event the relay never published. Must exceed a normal relay outage.
REAPER_ORPHAN_AFTER_SECONDS=120

# Publisher (Phase 7)
# `publish_jobs.scheduled_for` is the truth and the worker polls it, so a delayed
# queue message lost to a Redis restart costs latency rather than the post. This
# poll is that safety net - lower means tighter to the scheduled time and more
# database load.
PUBLISH_POLL_MS=1000
PUBLISH_LEASE_SECONDS=120     # how long a publish claim survives without a heartbeat
PUBLISH_HEARTBEAT_SECONDS=30  # must be <= half of PUBLISH_LEASE_SECONDS

# Observability
# METRICS_ENABLED controls prom-client's default PROCESS metrics (cpu, heap, gc).
# METRICS_COLLECTOR_ENABLED is separate: it controls whether the business gauges
# (failure rate, stuck jobs, ledger drift) are derived from the database. Turning
# the first off to save overhead must not turn the second off too - then /metrics
# serves a well-formed document that says nothing.
METRICS_COLLECTOR_ENABLED=true
# How often the collector re-derives its gauges. Must be >= the Prometheus scrape
# interval (15s) or two scrapes return the same numbers.
METRICS_INTERVAL_MS=15000

# Storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=renderflow-assets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# AI providers (mock by default - local dev and CI never call real APIs)
#
# THREE variables, not one. They are separately billable and separately likely to
# be unavailable, and a replica outage should not stop captions being written.
# Mixing a mock text provider with real image generation is a legitimate setup.
AI_PROVIDER=mock                # mock | anthropic | openai
IMAGE_PROVIDER=mock             # mock | replicate
TTS_PROVIDER=mock               # mock | elevenlabs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# Text provider preference order. Empty means "the one AI_PROVIDER names, then the
# other". A PERMANENT refusal STOPS the chain, so a fallback can never route
# around a moderation decision.
# TEXT_PROVIDER_FALLBACKS=anthropic,openai

# Burned into the corner of rendered reels. Empty means no watermark; when text is
# set but no font is installed the render still succeeds and reports that the
# mark was not applied, rather than failing every reel.
# BRAND_WATERMARK=Northwind
# BRAND_COLOR=#112233

# Mock provider failure injection (used by chaos + e2e tests).
#
# These names must match `mockOptionsFromEnv` in libs/ai. The mock is read at
# worker startup, so a typo fails silently as "nothing ever fails".
FAIL_STAGE=                   # comma separated, e.g. IMAGE,VOICE
FAIL_RATE=0                   # random failure probability, 0-1
FAIL_EVERY_NTH=               # fail every Nth call; DETERMINISTIC, prefer this
MOCK_LATENCY_MS=0             # artificial per-call latency

# Why FAIL_EVERY_NTH and not only FAIL_RATE: a random rate makes a suite flaky,
# and a flaky suite teaches people to re-run rather than to read the failure.
# The rate stays available for chaos runs, where the randomness is the point.

# Queues and the outbox relay (libs/queue)
#
# Retry presets have documented defaults (PROJECT.md section 8); override one
# knob per variable, e.g. QUEUE_CONTENT_ATTEMPTS=1 for a fast test run.
QUEUE_PREFIX=renderflow       # lets several environments share one Redis
# QUEUE_CONTENT_ATTEMPTS=3
# QUEUE_CONTENT_CONCURRENCY=5
# QUEUE_CONTENT_BACKOFF_MS=5000
# QUEUE_CONTENT_BACKOFF_TYPE=exponential

# The relay trades delivery latency against database load, so all three are
# configuration rather than literals in the polling loop.
OUTBOX_BATCH_SIZE=50          # rows claimed per poll
OUTBOX_POLL_INTERVAL_MS=1000  # delay after an empty poll
OUTBOX_MAX_ATTEMPTS=10        # failed publishes before an event is abandoned

# Social (mock by default)
SOCIAL_PROVIDER=mock            # mock | real
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000

# Email / notifications
SMTP_URL=smtp://mailhog:1025
WEB_BASE_URL=http://localhost:3000

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Observability
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001