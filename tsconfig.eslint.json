{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node", "jest"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "libs/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
